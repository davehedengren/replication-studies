# Copy this file to .env and fill in your values.

# --- API credentials ---
ANTHROPIC_API_KEY=sk-ant-...
OPENALEX_EMAIL=you@example.com
EMAIL_LOGIN=
PASSWORD=

# --- Storage paths ---
# Where downloaded ZIPs land before being moved (small, local).
# DOWNLOAD_DIR=/Users/you/code/replication-studies/aer-replication-crawler/download_staging

# Where ZIPs and PDFs are archived long-term (large, e.g. external drive).
# PACKAGE_ARCHIVE=/Volumes/External/AER_replication_data
# PDF_ARCHIVE=/Volumes/External/AER_replication_data_pdfs

# Tracker CSV path. Defaults to ../project_log.csv (the parent repo root).
# TRACKER_CSV=/Users/you/code/replication-studies/project_log.csv

# --- Crawler tuning ---
# How many successful downloads to target before stopping
TARGET_COUNT=500
# Politeness delays between requests, in seconds
MIN_DELAY=30
MAX_DELAY=60

# --- Browser ---
# Chrome must be launched with --remote-debugging-port=9222 first
CDP_URL=http://127.0.0.1:9222

# --- LLM ---
LLM_MODEL=claude-sonnet-4-6
